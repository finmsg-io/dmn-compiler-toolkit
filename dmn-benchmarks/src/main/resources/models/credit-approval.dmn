<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             id="credit-approval" name="Credit Approval Financial Risk Model" namespace="urn:finmsg:benchmark:credit-approval">
  
  <inputData id="input-credit-score" name="CreditScore">
    <variable id="input-credit-score-var" name="CreditScore" typeRef="number"/>
  </inputData>

  <inputData id="input-annual-income" name="AnnualIncome">
    <variable id="input-annual-income-var" name="AnnualIncome" typeRef="number"/>
  </inputData>

  <inputData id="input-requested-loan" name="RequestedLoan">
    <variable id="input-requested-loan-var" name="RequestedLoan" typeRef="number"/>
  </inputData>

  <decision id="decision-dti-ratio" name="DebtToIncomeRatio">
    <variable id="decision-dti-ratio-var" name="DebtToIncomeRatio" typeRef="number"/>
    <informationRequirement><requiredInput href="#input-annual-income"/></informationRequirement>
    <informationRequirement><requiredInput href="#input-requested-loan"/></informationRequirement>
    <literalExpression><text>RequestedLoan / AnnualIncome</text></literalExpression>
  </decision>

  <decision id="decision-risk-score" name="RiskScore">
    <variable id="decision-risk-score-var" name="RiskScore" typeRef="number"/>
    <informationRequirement><requiredInput href="#input-credit-score"/></informationRequirement>
    <informationRequirement><requiredDecision href="#decision-dti-ratio"/></informationRequirement>
    <decisionTable id="dt-risk-score" hitPolicy="FIRST">
      <input id="input-cs">
        <inputExpression typeRef="number"><text>CreditScore</text></inputExpression>
      </input>
      <input id="input-dti">
        <inputExpression typeRef="number"><text>DebtToIncomeRatio</text></inputExpression>
      </input>
      <output id="output-risk" typeRef="number"/>
      <rule id="r1">
        <inputEntry><text>&gt;= 750</text></inputEntry>
        <inputEntry><text>&lt;= 0.3</text></inputEntry>
        <outputEntry><text>1</text></outputEntry>
      </rule>
      <rule id="r2">
        <inputEntry><text>&gt;= 700</text></inputEntry>
        <inputEntry><text>&lt;= 0.4</text></inputEntry>
        <outputEntry><text>2</text></outputEntry>
      </rule>
      <rule id="r3">
        <inputEntry><text>&gt;= 650</text></inputEntry>
        <inputEntry><text>&lt;= 0.5</text></inputEntry>
        <outputEntry><text>3</text></outputEntry>
      </rule>
      <rule id="r4">
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
