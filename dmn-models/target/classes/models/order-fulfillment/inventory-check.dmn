<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             id="inventory-check-model"
             name="Inventory Check Model"
             namespace="urn:inventory-check">
  <decision id="inventoryCheckDecision" name="CheckInventory">
    <variable id="inventoryCheckVar" name="CheckInventory" typeRef="boolean"/>
    <literalExpression id="inventoryCheckExpr">
      <text>true</text>
    </literalExpression>
  </decision>
</definitions>
