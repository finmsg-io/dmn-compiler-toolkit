<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             id="shipping-calculator-model"
             name="Shipping Calculator Model"
             namespace="urn:shipping-calculator">
  <decision id="shippingCostDecision" name="CalculateShippingCost">
    <variable id="shippingCostVar" name="CalculateShippingCost" typeRef="number"/>
    <literalExpression id="shippingCostExpr">
      <text>12.50</text>
    </literalExpression>
  </decision>
</definitions>
