<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.finmsg.dmn</groupId>
    <artifactId>dmn-compiler-toolkit</artifactId>
    <version>1.0.0-rc.1</version>
  </parent>
  <artifactId>dmn-tck-runner</artifactId>
  <name>DMN TCK Runner</name>
  <description>Test infrastructure for executing DMN TCK cases through the toolkit</description>
  <properties>
    <!-- Default: skip TCK test execution during ordinary local builds unless -Ptck is explicitly specified -->
    <tck.skip>true</tck.skip>
    <tck.modelVariant>all</tck.modelVariant>
    <tck.requireFull>false</tck.requireFull>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.finmsg.dmn</groupId>
      <artifactId>dmn-compiler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.finmsg.dmn</groupId>
      <artifactId>dmn-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.finmsg.dmn</groupId>
      <artifactId>dmn-generator-java</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
        <configuration>
          <skipTests>${tck.skip}</skipTests>
          <useFile>false</useFile>
          <redirectTestOutputToFile>false</redirectTestOutputToFile>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <tck.modelVariant>${tck.modelVariant}</tck.modelVariant>
            <tck.requireFull>${tck.requireFull}</tck.requireFull>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- TCK profile: opt-in profile to run the full official OMG DMN TCK suite.
         Usage: mvn test -Ptck
                mvn verify -Ptck -->
    <profile>
      <id>tck</id>
      <properties>
        <tck.skip>false</tck.skip>
        <tck.modelVariant>optimized</tck.modelVariant>
        <tck.requireFull>true</tck.requireFull>
      </properties>
    </profile>
  </profiles>
</project>
