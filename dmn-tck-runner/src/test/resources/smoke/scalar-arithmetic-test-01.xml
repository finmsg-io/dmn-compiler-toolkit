<?xml version="1.0" encoding="UTF-8"?>
<testCases xmlns="http://www.omg.org/spec/DMN/20160719/testcase"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <testCase id="scalar-01" name="adds one">
    <inputNode name="age"><value xsi:type="xsd:decimal">20</value></inputNode>
    <resultNode name="nextAge"><expected><value xsi:type="xsd:decimal">21</value></expected></resultNode>
  </testCase>
  <testCase id="scalar-02" name="preserves decimal precision">
    <inputNode name="age"><value xsi:type="xsd:decimal">20.5</value></inputNode>
    <resultNode name="nextAge"><expected><value xsi:type="xsd:decimal">21.5</value></expected></resultNode>
  </testCase>
</testCases>
