<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20230324/MODEL/"
                 id="model-bkm-lib"
                 name="BKM Library"
                 namespace="urn:p2-04:bkm">
    <dmn:businessKnowledgeModel id="bkm-mult" name="multiplyBkm">
        <dmn:variable id="var-bkm-mult" name="multiplyBkm" typeRef="number"/>
        <dmn:encapsulatedLogic id="logic-bkm-mult">
            <dmn:formalParameter id="param-x" name="x" typeRef="number"/>
            <dmn:formalParameter id="param-y" name="y" typeRef="number"/>
            <dmn:literalExpression id="expr-bkm-mult">
                <dmn:text>x * y</dmn:text>
            </dmn:literalExpression>
        </dmn:encapsulatedLogic>
    </dmn:businessKnowledgeModel>
</dmn:definitions>
