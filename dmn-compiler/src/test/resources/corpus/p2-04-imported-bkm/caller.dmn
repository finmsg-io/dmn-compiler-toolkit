<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20230324/MODEL/"
                 id="model-caller"
                 name="Caller Model"
                 namespace="urn:p2-04:caller">
    <dmn:import namespace="urn:p2-04:bkm" locationURI="bkm-lib.dmn" name="BkmLib" importType="https://www.omg.org/spec/DMN/20230324/MODEL/"/>
    <dmn:decision id="dec-calc" name="calcResult">
        <dmn:variable id="var-calc" name="calcResult" typeRef="number"/>
        <dmn:knowledgeRequirement id="req-bkm">
            <dmn:requiredKnowledge href="urn:p2-04:bkm#bkm-mult"/>
        </dmn:knowledgeRequirement>
        <dmn:invocation id="inv-mult">
            <dmn:literalExpression id="expr-inv-bkm">
                <dmn:text>multiplyBkm</dmn:text>
            </dmn:literalExpression>
            <dmn:binding>
                <dmn:parameter id="p1" name="x"/>
                <dmn:literalExpression id="expr-p1">
                    <dmn:text>4</dmn:text>
                </dmn:literalExpression>
            </dmn:binding>
            <dmn:binding>
                <dmn:parameter id="p2" name="y"/>
                <dmn:literalExpression id="expr-p2">
                    <dmn:text>5</dmn:text>
                </dmn:literalExpression>
            </dmn:binding>
        </dmn:invocation>
    </dmn:decision>
</dmn:definitions>
