<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20230324/MODEL/"
                 id="model-applicant-score"
                 name="Applicant Score"
                 namespace="urn:p2-09:applicant-score">
    <dmn:itemDefinition id="item-applicant" name="tApplicant">
        <dmn:itemComponent id="comp-score" name="score">
            <dmn:typeRef>number</dmn:typeRef>
        </dmn:itemComponent>
        <dmn:itemComponent id="comp-income" name="income">
            <dmn:typeRef>number</dmn:typeRef>
        </dmn:itemComponent>
        <dmn:itemComponent id="comp-monthly-debt" name="monthlyDebt">
            <dmn:typeRef>number</dmn:typeRef>
        </dmn:itemComponent>
    </dmn:itemDefinition>

    <dmn:inputData id="input-applicant" name="Applicant">
        <dmn:variable id="var-applicant" name="Applicant" typeRef="tApplicant"/>
    </dmn:inputData>

    <dmn:decision id="dec-dti" name="DebtToIncomeRatio">
        <dmn:variable id="var-dti" name="DebtToIncomeRatio" typeRef="number"/>
        <dmn:informationRequirement id="req-applicant-dti">
            <dmn:requiredInput href="#input-applicant"/>
        </dmn:informationRequirement>
        <dmn:literalExpression id="expr-dti">
            <dmn:text>(Applicant.monthlyDebt * 12) / Applicant.income</dmn:text>
        </dmn:literalExpression>
    </dmn:decision>

    <dmn:decision id="dec-risk" name="RiskCategory">
        <dmn:variable id="var-risk" name="RiskCategory" typeRef="string"/>
        <dmn:informationRequirement id="req-applicant-risk">
            <dmn:requiredInput href="#input-applicant"/>
        </dmn:informationRequirement>
        <dmn:informationRequirement id="req-dti-risk">
            <dmn:requiredDecision href="#dec-dti"/>
        </dmn:informationRequirement>
        <dmn:decisionTable id="dt-risk" hitPolicy="UNIQUE">
            <dmn:input id="in-score">
                <dmn:inputExpression id="expr-in-score" typeRef="number">
                    <dmn:text>Applicant.score</dmn:text>
                </dmn:inputExpression>
            </dmn:input>
            <dmn:input id="in-dti">
                <dmn:inputExpression id="expr-in-dti" typeRef="number">
                    <dmn:text>DebtToIncomeRatio</dmn:text>
                </dmn:inputExpression>
            </dmn:input>
            <dmn:output id="out-risk" name="RiskCategory" typeRef="string"/>
            <dmn:rule id="rule-high-risk">
                <dmn:inputEntry id="ie-score-low">
                    <dmn:text>&lt; 600</dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="ie-dti-any1">
                    <dmn:text>-</dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="oe-high">
                    <dmn:text>"HIGH"</dmn:text>
                </dmn:outputEntry>
            </dmn:rule>
            <dmn:rule id="rule-low-risk">
                <dmn:inputEntry id="ie-score-high">
                    <dmn:text>&gt;= 600</dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="ie-dti-good">
                    <dmn:text>&lt;= 0.4</dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="oe-low">
                    <dmn:text>"LOW"</dmn:text>
                </dmn:outputEntry>
            </dmn:rule>
            <dmn:rule id="rule-med-risk">
                <dmn:inputEntry id="ie-score-high2">
                    <dmn:text>&gt;= 600</dmn:text>
                </dmn:inputEntry>
                <dmn:inputEntry id="ie-dti-bad">
                    <dmn:text>&gt; 0.4</dmn:text>
                </dmn:inputEntry>
                <dmn:outputEntry id="oe-med">
                    <dmn:text>"MEDIUM"</dmn:text>
                </dmn:outputEntry>
            </dmn:rule>
        </dmn:decisionTable>
    </dmn:decision>
</dmn:definitions>
