<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20230324/MODEL/"
                 id="model-policy-rules"
                 name="Policy Rules"
                 namespace="urn:p2-09:policy-rules">
    <dmn:businessKnowledgeModel id="bkm-max-loan" name="MaxLoanAmount">
        <dmn:variable id="var-max-loan" name="MaxLoanAmount" typeRef="number"/>
        <dmn:encapsulatedLogic id="logic-max-loan">
            <dmn:functionDefinition>
                <dmn:formalParameter id="param-risk" name="risk" typeRef="string"/>
                <dmn:formalParameter id="param-income" name="income" typeRef="number"/>
                <dmn:literalExpression id="expr-max-loan">
                    <dmn:text>if risk = "LOW" then income * 4 else if risk = "MEDIUM" then income * 2 else 0</dmn:text>
                </dmn:literalExpression>
            </dmn:functionDefinition>
        </dmn:encapsulatedLogic>
    </dmn:businessKnowledgeModel>
</dmn:definitions>
