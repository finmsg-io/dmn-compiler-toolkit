<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20230324/MODEL/"
                 id="cycle-model-a"
                 name="Cycle A"
                 namespace="urn:p2-08:a">
