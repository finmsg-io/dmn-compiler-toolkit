<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20230324/MODEL/"
                 id="model-right"
                 name="Right"
                 namespace="urn:p2-03:right">
    <dmn:import namespace="urn:p2-03:bottom" locationURI="bottom.dmn" name="Bottom" importType="https://www.omg.org/spec/DMN/20230324/MODEL/"/>
    <dmn:decision id="dec-right" name="rightVal">
        <dmn:variable id="var-right" name="rightVal" typeRef="number"/>
        <dmn:informationRequirement id="req-bottom-right">
            <dmn:requiredDecision href="urn:p2-03:bottom#dec-bottom"/>
        </dmn:informationRequirement>
        <dmn:literalExpression id="expr-right">
            <dmn:text>baseVal * 3</dmn:text>
        </dmn:literalExpression>
    </dmn:decision>
</dmn:definitions>
