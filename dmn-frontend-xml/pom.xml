<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.finmsg.dmn</groupId>
        <artifactId>dmn-compiler-toolkit</artifactId>
        <version>1.0.0-rc.3</version>
    </parent>

    <artifactId>dmn-frontend-xml</artifactId>

    <name>DMN XML Frontend</name>
    <description>DMN XML Reader/Writer based on VTD-XML</description>

    <dependencies>

        <!-- Semantic protobuf model -->
        <dependency>
            <groupId>io.finmsg.dmn</groupId>
            <artifactId>dmn-protobuf</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- VTD-XML -->
        <dependency>
            <groupId>com.ximpleware</groupId>
            <artifactId>vtd-xml</artifactId>
            <version>2.13.4</version>
        </dependency>

        <!-- SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JUnit -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>