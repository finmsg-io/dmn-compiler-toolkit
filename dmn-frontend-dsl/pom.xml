<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.finmsg.dmn</groupId>
        <artifactId>dmn-compiler-toolkit</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>dmn-frontend-dsl</artifactId>

    <name>DMN DSL Frontend</name>
    <description>ANTLR4-backed .decision authoring DSL parser, canonical formatter, and semantic protobuf lowerer</description>

    <dependencies>
        <dependency>
            <groupId>io.finmsg.dmn</groupId>
            <artifactId>dmn-protobuf</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr4.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr4.version}</version>
                <executions>
                    <execution>
                        <id>generate-decision-dsl-antlr</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <configuration>
                            <visitor>true</visitor>
                            <listener>false</listener>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report</id>
                        <configuration>
                            <excludes>
                                <exclude>io/finmsg/dmn/frontend/dsl/grammar/DecisionDslLexer*.class</exclude>
                                <exclude>io/finmsg/dmn/frontend/dsl/grammar/DecisionDslParser*.class</exclude>
                                <exclude>io/finmsg/dmn/frontend/dsl/grammar/DecisionDslVisitor.class</exclude>
                                <exclude>io/finmsg/dmn/frontend/dsl/grammar/DecisionDslBaseVisitor.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
